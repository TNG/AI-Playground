{
  "servers": {
    "datetime": {
      "id": "datetime",
      "name": "DateTime MCP",
      "command": "uvx",
      "args": ["mcp-server-time"]
    },
    "blender": {
      "id": "blender",
      "name": "Blender MCP (official)",
      "command": "C:\\Users\\username\\src\\blender\\blender_mcp\\venv\\Scripts\\blender-mcp.exe",
      "args": []
    },
    "ahujasidBlender": {
      "id": "ahujasidBlender",
      "name": "ahujasid/blender-mcp",
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
