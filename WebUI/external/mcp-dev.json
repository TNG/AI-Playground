{
  "mcpServers": {
    "datetime": {
      "displayName": "DateTime MCP",
      "command": "uvx",
      "args": ["mcp-server-time"]
    },
    "blender": {
      "displayName": "Blender MCP (official)",
      "command": "C:\\Users\\username\\src\\blender\\blender_mcp\\venv\\Scripts\\blender-mcp.exe"
    },
    "ahujasidBlender": {
      "displayName": "ahujasid/blender-mcp",
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    },
    "lenny-podcast": {
      "type": "http",
      "displayName": "Lenny Rachitsky Podcast",
      "url": "https://lenny-rachitsky.run.mcp.com.ai/mcp"
    }
  }
}
