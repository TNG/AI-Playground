{
  "type": "comfy",
  "name": "Upscale",
  "displayPriority": 900,
  "tags": ["OpenVINO", "no-prompt"],
  "backend": "comfyui",
  "category": "edit-images",
  "toolCategory": "edit-images",
  "description": "Increase resolution of an image with a local OpenVINO super-resolution model",
  "extendedDescription": "Select an upscale factor then drag in, or load an image to upscale. Click generate button. No prompt needed. The workflow runs a local OpenVINO super-resolution model directly inside ComfyUI instead of using OVMS.",
  "toolInstructions": "Use this workflow when the user wants to upscale, enhance resolution, or increase the size of an existing image. This is a no-prompt workflow: the prompt parameter is ignored. Simply select this workflow and the image will be upscaled using a local OpenVINO super-resolution model. Best for making small or low-resolution images larger and sharper without requiring OVMS support for upscaling.",
  "requiredCustomNodes": [],
  "requiredPythonPackages": ["openvino"],
  "requiredModels": [
    {
      "type": "openvino-image",
      "model": "onnxmodelzoo/super-resolution-10"
    }
  ],
  "settings": [
    {
      "type": "number",
      "label": "Batch Size",
      "displayed": false,
      "modifiable": false,
      "defaultValue": 1,
      "settingName": "batchSize"
    },
    {
      "type": "image",
      "label": "Input Image",
      "displayed": true,
      "modifiable": true,
      "defaultValue": "",
      "nodeTitle": "Load Image",
      "nodeInput": "image"
    },
    {
      "type": "number",
      "label": "Upscale Factor",
      "displayed": true,
      "modifiable": true,
      "defaultValue": 2,
      "min": 1,
      "max": 4,
      "step": 0.1,
      "nodeTitle": "OpenVINO Upscale",
      "nodeInput": "value"
    }
  ],
  "comfyUiApiWorkflow": {
    "3": {
      "inputs": {
        "filename_prefix": "AIPG_OpenVINO_Upscale",
        "images": ["2", 0]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Image"
      }
    },
    "2": {
      "inputs": {
        "image": ["1", 0],
        "model_path": "onnxmodelzoo/super-resolution-10/super-resolution-10.onnx",
        "scale_factor": ["4", 0],
        "device": "AUTO"
      },
      "class_type": "OpenVINOImageUpscale",
      "_meta": {
        "title": "OpenVINO Upscale"
      }
    },
    "1": {
      "inputs": {
        "image": ""
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load Image"
      }
    },
    "4": {
      "inputs": {
        "value": 2
      },
      "class_type": "PrimitiveFloat",
      "_meta": {
        "title": "OpenVINO Upscale"
      }
    }
  }
}
