{
  "type": "comfy",
  "name": "Upscale",
  "displayPriority": 900,
  "tags": ["OpenVINO", "no-prompt"],
  "backend": "comfyui",
  "category": "edit-images",
  "toolCategory": "edit-images",
  "description": "Increase resolution of an image with an OpenVINO super-resolution model",
  "extendedDescription": "Select an upscale factor then drag in, or load an image to upscale. Click generate button. No prompt needed.",
  "toolInstructions": "Use this workflow when the user wants to upscale, enhance resolution, or increase the size of an existing image. This is a no-prompt workflow: the prompt parameter is ignored. Simply select this workflow and the image will be upscaled using a local OpenVINO super-resolution model.",
  "requiredCustomNodes": [],
  "requiredPythonPackages": ["openvino"],
  "requiredModels": [
    {
      "type": "openvino-image",
      "model": "onnxmodelzoo/super-resolution-10"
    }
  ],
  "settings": [
    {
      "type": "number",
      "label": "Batch Size",
      "displayed": false,
      "modifiable": false,
      "defaultValue": 1,
      "settingName": "batchSize"
    },
    {
      "type": "boolean",
      "label": "Show Preview",
      "displayed": true,
      "modifiable": false,
      "defaultValue": false,
      "settingName": "showPreview"
    },
    {
      "type": "image",
      "label": "Input Image",
      "displayed": true,
      "modifiable": false,
      "defaultValue": "",
      "nodeTitle": "Load Image",
      "nodeInput": "image"
    },
    {
      "type": "number",
      "label": "Upscale Factor",
      "displayed": true,
      "modifiable": false,
      "defaultValue": 3,
      "min": 1,
      "max": 8,
      "step": 1,
      "nodeTitle": "upscale_factor",
      "nodeInput": "value"
    }
  ],
  "comfyUiApiWorkflow": {
    "9": {
      "inputs": {
        "filename_prefix": "AIPG_Image",
        "images": ["14", 0]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Image"
      }
    },
    "14": {
      "inputs": {
        "image": ["15", 0],
        "model_repo": "onnxmodelzoo/super-resolution-10",
        "scale_factor": ["24", 0]
      },
      "class_type": "OpenVINOImageUpscale",
      "_meta": {
        "title": "OpenVINO Image Upscale"
      }
    },
    "15": {
      "inputs": {
        "image": ""
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load Image"
      }
    },
    "16": {
      "inputs": {
        "value": 4
      },
      "class_type": "PrimitiveFloat",
      "_meta": {
        "title": "upscale_factor"
      }
    }
  }
}
