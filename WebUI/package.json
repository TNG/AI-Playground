{
  "name": "ai-playground",
  "private": true,
  "version": "3.3.0-beta",
  "license": "MIT",
  "homepage": "https://github.com/intel/AI-Playground",
  "author": {
    "name": "Intel® Corporation",
    "email": "webadmin@linux.intel.com"
  },
  "scripts": {
    "setup": "npm install && npm run fetch-external-resources && npm run ensure-electron && npm run ensure-native-modules && npm run install-hooks",
    "ensure-electron": "node ./build/scripts/ensure-electron.mjs",
    "ensure-native-modules": "node ./build/scripts/ensure-native-modules.mjs",
    "install-hooks": "node ./build/scripts/ensure-precommit-hook.mjs",
    "predev": "node ./build/scripts/ensure-electron.mjs && node ./build/scripts/ensure-native-modules.mjs",
    "dev": "cross-env VITE_DEBUG_TOOLS=\"true\" VITE_PLATFORM_TITLE=\"from Intel®\" AIPG_DEBUGGING_PORT=\"29222\" vite",
    "preview": "vite preview",
    "fetch-external-resources": "cross-env NODE_USE_ENV_PROXY=1 node --experimental-strip-types ./build/scripts/fetch-external-resources.mts",
    "patch-nsis-files": "node --experimental-strip-types ./build/scripts/patch-nsis-template.mts",
    "build": "npm run patch-nsis-files && cross-env-shell VITE_PLATFORM_TITLE=\"from Intel®\" \"vue-tsc && vite build && node --experimental-strip-types ./build/scripts/run-electron-builder.mts --config build/build-config.json --win --x64 --publish never && node --experimental-strip-types ./build/scripts/warn-bundled-wheels.mts\"",
    "build:linux": "cross-env-shell VITE_PLATFORM_TITLE=\"from Intel®\" \"vue-tsc && vite build && node --experimental-strip-types ./build/scripts/run-electron-builder.mts --config build/build-config.json --linux --x64 --publish never && node --experimental-strip-types ./build/scripts/warn-bundled-wheels.mts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pi": "node --experimental-strip-types scripts/verify/piIntegration.mts",
    "e2e:fast": "playwright test --config playwright-e2e.config.ts agentic-smoke.spec.ts",
    "e2e:full": "playwright test --config playwright-e2e.config.ts --grep-invert \"Agentic smoke\"",
    "lint:eslint": "eslint . --fix",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint:python": "npm run lint:ruff && npm run lint:bandit",
    "lint:ruff": "uvx ruff@0.15.20 check .. && uvx ruff@0.15.20 format --check ..",
    "lint:bandit": "uvx bandit@1.9.4 -c ../bandit.yaml -r ..",
    "lint:ci": "eslint .",
    "format:ci": "prettier --check .",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.97",
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@ai-sdk/vue": "^4.0.170",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@google/model-viewer": "^4.4.0",
    "@heroicons/vue": "^2.2.0",
    "@langchain/classic": "^1.0.61",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.4.0",
    "@langchain/openai": "^1.8.4",
    "@lmnr-ai/lmnr": "^0.8.61",
    "@lmnr-ai/pi-extension": "^0.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-icons/vue": "^1.0.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.3.0",
    "ai": "7.0.170",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "driver.js": "^1.12.1",
    "fs-extra": "^11.4.1",
    "get-port": "^7.2.0",
    "highlight.js": "^11.11.1",
    "just-bash": "^3.6.0",
    "koffi": "^3.3.7",
    "langchain": "^1.6.5",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "marked-highlight": "^2.2.4",
    "partysocket": "^1.2.0",
    "pi-hermes-memory": "0.9.6",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.11.0",
    "remove": "^0.1.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.183.2",
    "typebox": "^1.4.7",
    "uint8array-extras": "^1.6.0",
    "unpdf": "^1.9.1",
    "vee-validate": "^5.0.0-beta.1",
    "vue": "^3.5.45",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/adm-zip": "^0.5.8",
    "@types/dompurify": "^3.2.0",
    "@types/exif": "^0.6.5",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "adm-zip": "^0.6.1",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "electron": "^44.11.2",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.93.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "@napi-rs/canvas": "0.1.100",
    "langsmith": "^0.7.1",
    "uuid": "^14.0.0",
    "@langchain/community": {
      "@browserbasehq/stagehand": "^3.4.0",
      "openai": "^6.37.0"
    },
    "@ai-sdk/provider-utils": "^5.0.5",
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3"
    },
    "guarded-fetch": {
      "undici": "7.30.2"
    }
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_HOSTNAME": "127.0.0.1",
      "VITE_DEV_SERVER_PORT": 25413,
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:25413",
      "VSCODE_DEBUG": 1
    }
  },
  "main": "dist/main/main.js"
}
