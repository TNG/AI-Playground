# AI Playground container configuration
# This file is auto-generated by containers/run.sh on each launch.
# For manual overrides, copy to .env and edit:
#   cp containers/.env.example containers/.env
# Then run docker compose directly without run.sh.

# ── Display (required) ────────────────────────────────────────────────────────
# Host X11 display. Run `echo $DISPLAY` in a desktop terminal to find this.
# Common values: :0 (standard), :1024 (KVM/IPMI virtual display)
DISPLAY=:0

# ── X authority ───────────────────────────────────────────────────────────────
# Path to .Xauthority on the host. Allows container to open windows on desktop.
# Run `echo $XAUTHORITY` — if set, use that value. Otherwise use ~/.Xauthority
XAUTHORITY=~/.Xauthority

# ── GPU group IDs ─────────────────────────────────────────────────────────────
# GIDs for /dev/dri access. Auto-detected by run.sh.
# Check on host: getent group video render
VIDEO_GID=44
RENDER_GID=992

# ── Proxy (optional) ──────────────────────────────────────────────────────────
# Forwarded into the container for model downloads and backend installation.
# http_proxy=http://proxy.example.com:911
# https_proxy=http://proxy.example.com:911
# no_proxy=localhost,127.0.0.1,*.intel.com
#
# BUILD_NO_PROXY is auto-derived by run.sh from no_proxy/NO_PROXY above with
# .intel.com stripped out, and used only for the image build — not the running
# container. Without this, a no_proxy like the example above (common on Intel
# corporate networks) makes the build try to reach repositories.intel.com
# (Intel's public GPU/NPU driver repo) directly instead of via the proxy,
# which hangs and fails. You shouldn't need to set BUILD_NO_PROXY by hand.

# ── Corporate CA certificate (optional) ──────────────────────────────────────
# If your network TLS-intercepts HTTPS (proxy re-signs with an internal CA),
# app downloads at runtime (e.g. llama.cpp from GitHub) fail with
# ERR_CERT_AUTHORITY_INVALID. Export AIPG_EXTRA_CA_CERT=/path/to/corp-ca.pem
# before running run.sh (or set NODE_EXTRA_CA_CERTS / SSL_CERT_FILE /
# REQUESTS_CA_BUNDLE / CURL_CA_BUNDLE, which run.sh also checks) and it will
# be copied into containers/ca-certs/ and trusted inside the image.

# ── HuggingFace endpoint (optional) ──────────────────────────────────────────
# Override only if using a corporate HuggingFace mirror.
# HF_ENDPOINT=https://huggingface.co

# ── NPU driver version (advanced) ────────────────────────────────────────────
# Must match the intel_vpu kernel module version on the host.
# Default matches ENIB (kernel 6.18-intel). Check: dpkg -l | grep intel-level-zero-npu
# NPU_VERSION=v1.32.0
# NPU_BUILD=v1.32.0.20260402-23905121947
