      }
    },
    "2": {
      "inputs": {
        "clip_name": "Comfy-Org---MiniMax-H3\\text_encoders\\qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
        "type": "minimax",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "Load CLIP"
      }
    },
    "3": {
      "inputs": {
        "vae_name": "Comfy-Org---MiniMax-H3-Image\\vae\\minimax_h3_image_vae_fp16.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "Load VAE"
      }
    },
    "5": {
      "inputs": {
        "prompt": "A sweeping aerial photograph of a terraced mountain village at golden hour, whitewashed houses with terracotta roofs stepping down toward a turquoise bay, fishing boats moored along a stone harbor wall, laundry lines between balconies, warm low sunlight raking across the terraces, crisp detail in every window and roof tile, shot on a medium format camera.",
        "width": 4096,
        "height": 4096,
        "clip": ["2", 0]
      },
      "class_type": "MiniMaxH3ImageConditioning",
      "_meta": {
        "title": "prompt"
      }
    },
    "6": {
      "inputs": {
        "conditioning": ["5", 0]
      },
      "class_type": "ConditioningZeroOut",
      "_meta": {
        "title": "ConditioningZeroOut"
      }
    },
    "7": {
      "inputs": {
        "seed": 0,
        "steps": 6,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1,
        "model": ["1", 0],
        "positive": ["5", 0],
        "negative": ["6", 0],
        "latent_image": ["5", 1]
      },
      "class_type": "KSampler",
      "_meta": {
        "title": "KSampler"
      }
    },
    "8": {
      "inputs": {
        "samples": ["7", 0],
        "vae": ["3", 0]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode"
      }
    },
    "9": {
      "inputs": {
        "filename_prefix": "AIPG_Image",
        "images": ["98", 0]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Image"
      }
    },
    "98": {
      "inputs": {
        "threshold": ["99", 0],
        "cuda": false,
        "image": ["8", 0]
      },
      "class_type": "SafetyChecker",
      "_meta": {
        "title": "Intercept NSFW Outputs"
      }
    },
    "99": {
      "inputs": {
        "op": "Sub",
        "a": 1,
        "b": 0.5
      },
      "class_type": "CM_FloatBinaryOperation",
      "_meta": {
        "title": "SafetyCheckerStrength"
      }
    }
  }
