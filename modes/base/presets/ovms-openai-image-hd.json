      "displayed": true,
      "modifiable": true,
      "defaultValue": true,
      "settingName": "showPreview"
    },
    {
      "type": "string",
      "label": "Image API base URL",
      "displayed": false,
      "modifiable": true,
      "defaultValue": "http://127.0.0.1:8000/v3",
      "nodeTitle": "prompt",
      "nodeInput": "base_url"
    },
    {
      "type": "string",
      "label": "Model id",
      "displayed": false,
      "modifiable": true,
      "defaultValue": "OpenVINO/Juggernaut-XL-v9-int8-ov",
      "nodeTitle": "prompt",
      "nodeInput": "model"
    }
  ],
  "comfyUiApiWorkflow": {
    "1": {
      "inputs": {
        "base_url": "http://127.0.0.1:8000/v3",
        "model": "OpenVINO/Juggernaut-XL-v9-int8-ov",
        "text": "",
        "seed": 0,
        "steps": 30,
        "width": 1024,
        "height": 1024
      },
      "class_type": "OpenAICompatibleImageGeneration",
      "_meta": {
        "title": "prompt"
      }
    },
    "2": {
      "inputs": {
        "filename_prefix": "AIPG_OVMS_HD",
        "images": ["1", 0]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Image"
      }
    }
  }
}
