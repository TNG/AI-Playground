{
  "type": "comfy",
  "name": "OVMS HD Image",
  "displayPriority": 421,
  "tags": ["OVMS", "OpenVINO", "JuggernautXL", "1024x1024"],
  "backend": "comfyui",
  "category": "create-images",
  "description": "High quality SDXL image generation via an OpenAI-compatible image API served by OpenVINO Model Server (Juggernaut-XL v9, 1024x1024)",
  "extendedDescription": "Runs text-to-image through ComfyUI using a remote /v3/images/generations endpoint backed by OpenVINO/Juggernaut-XL-v9-int8-ov. Produces photorealistic 1024x1024 images via SDXL. For testing, run OVMS locally (default base URL http://127.0.0.1:8000/v3). Adjust the API base URL in settings when your server uses another port.",
  "mediaType": "image",
  "toolCategory": "create-images",
  "toolInstructions": "Write a detailed text prompt describing the image: subject, style, lighting, composition, and quality tags. Juggernaut-XL is SDXL-based and rewards rich, descriptive prompts; emphasize photorealistic detail, professional photography terms, and explicit style cues.",
  "resolutionConfig": {
    "megapixels": [
      { "label": "0.5", "totalPixels": 495616 },
      { "label": "0.8", "totalPixels": 802816 },
      { "label": "1.0", "totalPixels": 1048576 }
    ],
    "aspectRatios": ["16/9", "3/2", "4/3", "1/1", "3/4", "2/3", "9/16"]
  },
  "requiredModels": [
    {
      "type": "openvino-image",
      "model": "OpenVINO/Juggernaut-XL-v9-int8-ov"
    }
  ],
  "requiredPythonPackages": [],
  "settings": [
    {
      "type": "string",
      "label": "Prompt",
      "displayed": false,
