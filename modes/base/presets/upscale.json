    {
      "type": "number",
      "label": "Upscale Factor",
      "displayed": true,
      "modifiable": true,
      "defaultValue": 2,
      "min": 1,
      "max": 4,
      "step": 0.1,
      "nodeTitle": "upscale_factor",
      "nodeInput": "value"
    }
  ],
  "comfyUiApiWorkflow": {
    "9": {
      "inputs": {
        "filename_prefix": "AIPG_Image",
        "images": ["16", 0]
