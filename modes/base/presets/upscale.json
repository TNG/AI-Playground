    {
      "name": "OpenVINO Default",
      "displayName": "Default",
      "backend": "openvino",
      "requiresService": "openvino-backend",
      "replaceWorkflow": true,
      "overrides": {
        "tags": ["OpenVINO", "no-prompt"],
        "description": "Increase resolution of an image up to 4X with OpenVINO",
        "extendedDescription": "Select an upscale factor then drag in, or load an image to upscale. Click generate button. No prompt needed. Runs an OpenVINO super-resolution model in-process inside ComfyUI (does not call the OVMS server).",
        "toolInstructions": "Use this workflow when the user wants to upscale, enhance resolution, or increase the size of an existing image. This is a no-prompt workflow: the prompt parameter is ignored. Simply select this workflow and the image will be upscaled using an OpenVINO super-resolution model, then resized to the requested factor. Best for making small or low-resolution images larger and sharper.",
        "requiredCustomNodes": [],
