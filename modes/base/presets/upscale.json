{
  "type": "comfy",
  "name": "Upscale",
  "displayPriority": 900,
  "tags": ["OpenVINO", "no-prompt"],
  "backend": "comfyui",
  "category": "edit-images",
  "toolCategory": "edit-images",
  "description": "Increase resolution of an image up to 4X with OpenVINO",
  "extendedDescription": "Select an upscale factor then drag in, or load an image to upscale. Click generate button. No prompt needed.",
  "toolInstructions": "Use this workflow when the user wants to upscale, enhance resolution, or increase the size of an existing image. This is a no-prompt workflow: the prompt parameter is ignored. Simply select this workflow and the image will be upscaled using an OpenVINO super-resolution model, then resized to the requested factor. Best for making small or low-resolution images larger and sharper.",
  "requiredPythonPackages": ["openvino"],
  "requiredModels": [
    {
      "type": "openvino-image",
      "model": "onnxmodelzoo/super-resolution-10"
    }
  ],
  "settings": [
    {
      "type": "number",
      "label": "Batch Size",
      "displayed": false,
      "modifiable": false,
      "defaultValue": 1,
      "settingName": "batchSize"
    },
    {
      "type": "image",
      "label": "Input Image",
      "displayed": true,
      "modifiable": true,
      "defaultValue": "",
      "nodeTitle": "Load Image",
      "nodeInput": "image"
    },
    {
      "type": "number",
      "label": "Upscale Factor",
      "displayed": true,
      "modifiable": true,
      "defaultValue": 2,
      "min": 1,
      "max": 4,
      "step": 0.1,
      "nodeTitle": "OpenVINO Upscale",
      "nodeInput": "target_scale"
    },
    {
      "type": "string",
      "label": "Model Path",
      "displayed": false,
      "modifiable": true,
      "defaultValue": "onnxmodelzoo---super-resolution-10/super-resolution-10.onnx",
      "nodeTitle": "OpenVINO Upscale",
      "nodeInput": "model_path"
    },
    {
      "type": "string",
      "label": "Device",
      "displayed": false,
      "modifiable": true,
      "defaultValue": "AUTO",
      "nodeTitle": "OpenVINO Upscale",
      "nodeInput": "device"
    }
  ],
  "comfyUiApiWorkflow": {
    "9": {
      "inputs": {
        "filename_prefix": "AIPG_Image",
        "images": ["16", 0]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Image"
      }
    },
    "15": {
      "inputs": {
        "image": ""
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load Image"
      }
    },
    "16": {
      "inputs": {
        "image": ["15", 0],
        "model_path": "onnxmodelzoo---super-resolution-10/super-resolution-10.onnx",
        "target_scale": 2,
        "device": "AUTO"
      },
      "class_type": "OpenVINOImageUpscale",
      "_meta": {
        "title": "OpenVINO Upscale"
      }
    }
  }
}
