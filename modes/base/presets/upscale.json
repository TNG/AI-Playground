            }
          },
          "15": {
            "inputs": {
              "image": ""
            },
            "class_type": "LoadImage",
            "_meta": {
              "title": "Load Image"
            }
          },
          "16": {
            "inputs": {
              "image": ["15", 0],
              "model_path": "onnxmodelzoo---super-resolution-10/super-resolution-10.onnx",
              "target_scale": 2,
